# Exemplo de .env para o backend (não compartilhe chaves reais)
# Valores que devem existir para o backend Python (app/)
SUPABASE_URL=https://xyzcompany.supabase.co
SUPABASE_KEY=your-service-role-or-anon-key

# Para verificação de JWT no backend (usado em app/routers/auth.py)
# Use o "JWT Public Key" disponível em Settings > API no dashboard do Supabase
# Se você preferir usar a chave secreta HMAC (não recomendado para produção), preencha SUPABASE_JWT_SECRET
SUPABASE_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqh...\n-----END PUBLIC KEY-----"
# SUPABASE_JWT_SECRET=your-hs256-secret-if-used

# Variáveis usadas no frontend (vite) — coloque em frontend/.env.local ou no .env do projeto frontend
# VITE_SUPABASE_URL and VITE_SUPABASE_KEY são lidas pelo frontend durante build/dev
VITE_SUPABASE_URL=https://xyzcompany.supabase.co
VITE_SUPABASE_KEY=your-anon-key

# Observações:
# - No backend é comum usar a service_role key para operações administrativas. Proteja essa chave e nunca comite no repositório.
# - O arquivo .env não deve ser commitado. Copie .env.example para .env e preencha com os valores reais no seu ambiente local.
