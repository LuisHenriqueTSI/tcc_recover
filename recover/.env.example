# Copy this file to .env and fill in real values locally (do NOT commit .env)

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Google (preferred: point to a service account JSON)
# If you use a service account JSON, set:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# Alternatively, you can set an API key (less secure):
# GOOGLE_API_KEY=your_google_api_key

# Preferred: set the path to your service account JSON and use that for Gemini
# Example:
# GOOGLE_APPLICATION_CREDENTIALS=/home/you/keys/gemini-sa-329088153964.json

# JWT / app
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
